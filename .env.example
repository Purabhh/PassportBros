# Copy to .env and fill in. Never commit .env.

# ─── Neon Postgres ──────────────────────────────────────────────────────
# Get from https://console.neon.tech → your project → Connection Details
# Should start with postgresql:// and end with ?sslmode=require
DATABASE_URL=postgresql://user:pass@host.neon.tech/passportbros?sslmode=require

# ─── Cloudflare R2 ──────────────────────────────────────────────────────
# Get from Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=passportbros-media
# Public URL of your bucket — see R2 → bucket → Settings → Public Access.
# If you enable Public Access, it'll be like https://pub-xxxx.r2.dev
# Or set up a custom domain. Leave blank to use signed-read URLs (slower).
R2_PUBLIC_BASE_URL=

# ─── Secrets ────────────────────────────────────────────────────────────
# Any long random string — used to sign cookies. Generate with `openssl rand -hex 32`.
COOKIE_SECRET=replace-me-with-a-long-random-string

# ─── Dev only ───────────────────────────────────────────────────────────
PORT=3001
